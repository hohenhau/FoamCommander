FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      customProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// Base directory. Ensures that the simulation uses the correct properties
directory  path/to/base/directory/;

// Flow type used to estimate boundary conditions.
flowType  internal;  // Options: {internal, external}

// Type of fluid. Used to calculate nu. Unused if nu is specified
fluidType  None;  // Options: {None, air, water}

// Freestream Velocity. Most be specified if flowType is internal
freestreamVelocity  None;  // Freestream velocity for flow metrics

// Atmospheric pressure. Used to estimate boundary conditions and variables
freestreamPressure  None;  // Pressure in Pascals (1 atmosphere = 101,325 Pascals)

// Temperature in Celsius. Used to estimate boundary conditions and variables
temperature  None;  // Temperature in Celsius

// Density in kg/m^3. Used to estimate the pressure loss for line probes
density  None;  // Density in kg/m^3

// Hydraulic diameter. Must be specified if flowType is internal
hydraulicDiameter  None;  // Hydraulic diameter for internal flows

// Kinematic viscosity of the fluid. Must be specified if fluid is unspecified
nu  None;  // 'None' or a floating point number


